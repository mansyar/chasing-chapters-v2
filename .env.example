# Database
DATABASE_URI=postgresql://postgres:YOUR_SECURE_PASSWORD@postgres:5432/chasing-chapters
PAYLOAD_SECRET=YOUR_VERY_LONG_AND_SECURE_SECRET_KEY_HERE

# PostgreSQL connection pool. Defaults: 10 connections max, 2 kept open, and
# 10,000 ms to acquire one. Every app instance opens its own pool, so keep
# `max` multiplied by the number of instances below the database's own
# connection ceiling (production Postgres allows ~100 by default).
# An invalid or empty value falls back to the default and logs once.
# DB_POOL_MAX=10
# DB_POOL_MIN=2
# DB_POOL_CONNECT_TIMEOUT_MS=10000
# A deferred pooled read that takes longer than this (ms) is logged as a
# structured warning; a read that gives up waiting instead reports the same
# milliseconds on `neighbour_lookup_failed`. Together they are how a starved
# pool announces itself. Defaults to 1000.
# DB_POOL_SLOW_ACQUIRE_MS=1000

# Cloudflare R2 Storage
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_PUBLIC_URL=https://your-bucket.your-domain.com

# Storage adapter: s3 (object storage, default) or local (Payload disk storage, used by the e2e run)
STORAGE_ADAPTER=s3

# Site URL (for sitemap, OG images, etc.)
NEXT_PUBLIC_APP_URL=https://chasing-chapters.com

# Production PostgreSQL (for docker-compose.prod.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_DB=chasing-chapters

# SSL/Let's Encrypt (for Traefik)
ACME_EMAIL=your-email@example.com

# Sentry Error Tracking
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Note: SENTRY_DSN is hardcoded in sentry config files, update there if needed

# Google Cloud Translation API
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./google-cloud-credentials.json
# OR use inline JSON (for Docker deployments)
# GOOGLE_CLOUD_CREDENTIALS={"type":"service_account","project_id":"..."}

# Characters per 100-second window allowed to reach the Translation API.
# Defaults to Google's v2 per-user default of 100,000. Raise this to match your
# Google Cloud console quota, or pacing stays conservative. An empty value falls
# back to the default; set it explicitly when the console quota is raised.
# TRANSLATION_CHAR_BUDGET=100000

# Redis (for translation caching)
REDIS_URL=redis://:your-redis-password@localhost:6379

# Umami Analytics
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id